# SQLite for local dev (relative to backend/ when run from there).
DATABASE_URL=sqlite:///./smartchange.db
# Comma-separated allowed frontend origins for CORS.
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# AI SOP assistant (optional; core app works without any provider).
# SMARTCHANGE_AI_PROVIDER=none            # default: excerpt-based answers, no key needed
# SMARTCHANGE_AI_PROVIDER=openai-compatible
# SMARTCHANGE_AI_BASE_URL=https://your-provider/v1
# SMARTCHANGE_AI_API_KEY=                # never commit a real key
# SMARTCHANGE_AI_MODEL=
# SMARTCHANGE_AI_TIMEOUT_SECONDS=20
# Max document upload size in MB.
# SMARTCHANGE_DOCS_MAX_MB=5
